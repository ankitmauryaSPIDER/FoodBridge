# Local Docker Compose defaults are defined in docker-compose.yml.
# Change every secret before any public deployment.
DB_URL=jdbc:mysql://localhost:3306/foodbridge?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=foodbridge
DB_PASSWORD=replace-with-a-strong-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=uploads
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-this-admin-password
